{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VETRYAKI",
  "version": "0.1.0",
  "identifier": "com.egor-blyablin.vetryaki",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "http": {
      "enabled": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "VETRYAKI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "linux": {
      "deb": {
        "files": {}
      }
    },
    "targets": "deb",
    "icon": [
      "../public/logo128.png",
      "../public/logo512.png"
    ]
  }
}
